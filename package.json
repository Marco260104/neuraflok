{
  "name": "neuraflok",
  "version": "0.1.9",
  "description": "A desktop coding workspace for signed-in DeepSeek, Kimi, Qwen, and Z AI sessions with approved local tools.",
  "license": "MIT",
  "author": {
    "name": "NEURAFLOK contributors",
    "email": "noreply@github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARCO260104/neuraflok.git"
  },
  "bugs": {
    "url": "https://github.com/MARCO260104/neuraflok/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "desktopName": "com.neuraflok.desktop",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/stamp-dev-icon.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run verify:ci",
    "verify:ci": "npm run rg && npm run verify:privacy && npm run verify:notices && npm run typecheck && node -e \"require('electron')\" && vitest run --maxWorkers=8 --exclude test/mcp-shutdown.test.ts --exclude test/computer.test.ts && vitest run --maxWorkers=1 test/computer.test.ts test/mcp-shutdown.test.ts",
    "verify:notices": "node scripts/generate-third-party-notices.mjs --check && node scripts/package-native-sources.mjs --check",
    "verify:privacy": "node scripts/verify-public-history.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "icon": "node scripts/make-icon.mjs && node scripts/stamp-dev-icon.mjs --stamp-only",
    "rg": "node scripts/fetch-ripgrep.mjs",
    "packaging:prepare": "node scripts/prepare-packaging-native.mjs",
    "desktop:mac": "node scripts/prepare-macos-desktop-helper.mjs --platform darwin",
    "dist": "node scripts/packaging/build-desktop.mjs --arch x64,arm64",
    "dist:win": "node scripts/packaging/build-desktop.mjs --platform win32 --arch x64,arm64",
    "dist:x64": "node scripts/packaging/build-desktop.mjs --platform win32 --arch x64",
    "dist:arm64": "node scripts/packaging/build-desktop.mjs --platform win32 --arch arm64",
    "dist:mac": "node scripts/packaging/build-desktop.mjs --platform darwin --arch x64,arm64",
    "dist:mac:x64": "node scripts/packaging/build-desktop.mjs --platform darwin --arch x64",
    "dist:mac:arm64": "node scripts/packaging/build-desktop.mjs --platform darwin --arch arm64",
    "dist:linux": "node scripts/packaging/build-desktop.mjs --platform linux --arch x64,arm64",
    "dist:linux:x64": "node scripts/packaging/build-desktop.mjs --platform linux --arch x64",
    "dist:linux:arm64": "node scripts/packaging/build-desktop.mjs --platform linux --arch arm64",
    "dist:dir": "node scripts/packaging/build-desktop.mjs --arch x64,arm64 --dir",
    "dist:dir:win": "node scripts/packaging/build-desktop.mjs --platform win32 --arch x64,arm64 --dir",
    "dist:dir:x64": "node scripts/packaging/build-desktop.mjs --platform win32 --arch x64 --dir",
    "dist:dir:arm64": "node scripts/packaging/build-desktop.mjs --platform win32 --arch arm64 --dir",
    "dist:dir:mac:x64": "node scripts/packaging/build-desktop.mjs --platform darwin --arch x64 --dir",
    "dist:dir:mac:arm64": "node scripts/packaging/build-desktop.mjs --platform darwin --arch arm64 --dir",
    "dist:dir:mac": "node scripts/packaging/build-desktop.mjs --platform darwin --arch x64,arm64 --dir",
    "dist:dir:linux:x64": "node scripts/packaging/build-desktop.mjs --platform linux --arch x64 --dir",
    "dist:dir:linux:arm64": "node scripts/packaging/build-desktop.mjs --platform linux --arch arm64 --dir",
    "dist:dir:linux": "node scripts/packaging/build-desktop.mjs --platform linux --arch x64,arm64 --dir",
    "test:kill": "node scripts/kill-stray-vitest.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lezer/highlight": "^1.2.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "js-yaml": "4.3.2",
    "katex": "0.18.9",
    "marked": "18.0.14",
    "node-pty": "1.2.0-beta.15",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@phosphor-icons/web": "2.1.2",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "8.18.1",
    "axe-core": "4.13.0",
    "electron": "44.3.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "rcedit": "^5.0.2",
    "resedit": "^1.7.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
